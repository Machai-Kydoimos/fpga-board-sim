  "port_conventions": {
    "zeowaa": {
      "description": "Zeowaa EP4CE6 development board. Hand-authored from two independent constraint files that agree on every pin: marsohod4you/basics-graphics-music boards/zeowaa (board_specific.qsf, names ABCDEFGH_N/DIGIT_N/LED_N/SW_N/KEY_N) and MIPSfpga/digital-design-lab-manual lab_11/src/board/zeowaa (zeowaa.qsf, names hex/digit/led/sw/key). The two differ only in index direction for the LED, segment and button banks -- a labeling convention, not a physical fact -- so the self-documenting ABCDEFGH order is used for the segments (index 0 = segment A). Both SDCs declare the clock at 50 MHz. Every bank is active-low, stated by the _N suffix throughout the first source. Segments are named for the segment letters, which the shared classifier does not recognize, so this convention is hand-authored here rather than generated.",
      "naming": "canonical",
      "clk": "CLK",
      "leds": {
        "name": "LED_N",
        "width": 12,
        "active_low": true
      },
      "switches": {
        "name": "SW_N",
        "width": 8,
        "active_low": true
      },
      "buttons": {
        "name": "KEY_N",
        "width": 4,
        "active_low": true
      },
      "seven_seg": {
        "style": "scan",
        "name": "ABCDEFGH_N",
        "width_per_digit": 8,
        "active_low": true,
        "digit_enable": {
          "name": "DIGIT_N",
          "width": 8,
          "active_low": true
        }
      }
    }
  }
